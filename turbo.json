{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", "tsconfig.base.json"],
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_PRIVY_APP_ID",
    "NEXT_PUBLIC_SOLANA_RPC_URL",
    "NEXT_PUBLIC_PROGRAM_ID",
    "NEXT_PUBLIC_USDC_MINT",
    "PRIVY_APP_SECRET",
    "ELEVENLABS_API_KEY",
    "ELEVENLABS_AGENT_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
