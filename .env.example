# ChickenPicks OnChain — environment variables
# Copy to .env (never commit). All variables documented below.

# ────────────────────────────────────────────────────────────────────────────
# Solana
# ────────────────────────────────────────────────────────────────────────────
# Cluster: devnet for hackathon. Override with your own RPC for higher rate limits.
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.devnet.solana.com"
# Filled in after `anchor deploy` (Day 0/1) — same value committed in packages/shared/src/constants.ts
NEXT_PUBLIC_PROGRAM_ID=""
# Devnet USDC mint (Circle). Verify before use; alternate: 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU (USDC-Dev)
NEXT_PUBLIC_USDC_MINT="Gh9ZwEmdLJ8DscKNTkTqPbNwLNNBjuSzaG9Vp2KGtKJr"

# ────────────────────────────────────────────────────────────────────────────
# Privy (auth + embedded Solana wallets)
# https://dashboard.privy.io
# ────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=""
PRIVY_APP_SECRET=""

# ────────────────────────────────────────────────────────────────────────────
# ElevenLabs Conversational AI (voice agent)
# https://elevenlabs.io → Profile → API Keys, Conversational AI → Agents
# ────────────────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=""
ELEVENLABS_AGENT_ID=""

# ────────────────────────────────────────────────────────────────────────────
# Platform authority (for /admin gate)
# Public key of the wallet allowed to post fake match results + initialize platform
# This is the deployer pubkey from keys/deployer.json — paste after `solana-keygen new`
# ────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PLATFORM_AUTHORITY=""
