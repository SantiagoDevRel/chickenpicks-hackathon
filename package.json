{
  "name": "chickenpicks-onchain",
  "private": true,
  "version": "0.0.1",
  "description": "Fully on-chain football prediction market on Solana — Dev3pack hackathon May 2026",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.0.0 <21.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "init:platform": "tsx scripts/init-platform.ts",
    "mint:setup": "tsx scripts/setup-test-mint.ts",
    "seed:demo": "tsx scripts/seed-demo-polla.ts",
    "fund": "tsx scripts/fund-user.ts",
    "post:results": "tsx scripts/post-results.ts",
    "settle": "tsx scripts/settle-polla.ts"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.31.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.4",
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "axios@<1.15.2": "^1.15.2"
    }
  }
}
